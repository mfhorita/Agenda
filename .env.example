# Copie este arquivo para .env e preencha os valores antes de fazer deploy.
# O arquivo .env NÃO deve ser commitado no repositório.

# Gere uma nova chave com: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=sua-chave-secreta-aqui

# False em produção, True apenas em desenvolvimento local
DEBUG=False

# Hosts permitidos separados por vírgula
# Exemplo Heroku: .herokuapp.com
# Exemplo domínio: meudominio.com.br
ALLOWED_HOSTS=127.0.0.1,localhost
